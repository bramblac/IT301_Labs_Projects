
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Promises, fetch and APIs</title>
</head>
<body>
    <h1>Profile</h1>
    <p>Welcome to my page that contains pics of users!</p>

    <script>
        // Consume the promise using async/await
        let img = document.createElement('img');
        let name = document.createElement('p');
        let email = document.createElement('p');
        let phone = document.createElement('p');
        let bttn = document.createElement('button');

        bttn.type = 'button';
        bttn.textContent = 'Generate Profile';

        let form = document.createElement('form');
        form.action = '#';
        form.appendChild(bttn);

        img.style.width = '300px';
        img.style.height = '300px';

        document.body.appendChild(form);
        document.body.appendChild(img);
        document.body.appendChild(name);
        document.body.appendChild(email);
        document.body.appendChild(phone);

        const createImage = async () => {
            try {
                let p = await fetch('https://randomuser.me/api/');
                p = await p.json();

                let src = p.results[0].picture.large;
                img.src = src;
                img.alt = 'User profile picture';

                console.log(p);
                name.textContent = `Name: ${p.results[0].name.first} ${p.results[0].name.last}`;
                email.textContent = `Email: ${p.results[0].email}`;
                phone.textContent = `Phone: ${p.results[0].phone}`;
                
            } catch (error) {
                console.error('Error fetching user image:', error);
            }

        };

        createImage();
        bttn.addEventListener('click', createImage);
    </script>
</body>
</html>
